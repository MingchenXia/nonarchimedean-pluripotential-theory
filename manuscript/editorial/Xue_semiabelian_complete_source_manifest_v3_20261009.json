    {
      "locator": "Lemmas 54–56, pp. 38–39; Theorem 61, pp. 41–43",
      "status": "LITERAL AUXILIARY ESTIMATES DISPROVED IN KNOWN TORIC MODEL",
      "detail": "Same-index translated-circle comparison has normalized limit gap 1/5; the metrized pullback changes D_m to D_mn. Main theorem remains unverified, not refuted."
    },
    {
      "locator": "Propositions 90 and 9.5, pp. 57–60",
      "status": "LITERAL WHOLE-SLICE FORMULA DISPROVED IN KNOWN TORIC CURVE",
      "detail": "The P2 curve (z,1+z) requires actual polyhedral corner domains. Product corners, saturated primitive rank-one normals and zero boundary mass do not supply constant positive whole-slice Haar weights."
    },
    {
      "locator": "Proposition 9.6, p. 60",
      "status": "OVERBROAD FUNCTORIALITY DISPROVED IN STANDARD MODEL",
      "detail": "On the product-boundary curve (z,1+z), beta=z2 pushes a Haar slice to a circle centered at 1; its tropical pushforward is not finite atomic. An ambient monomial need not factor through the active coordinate quotient."
    },
    {
      "locator": "Proposition 78, Lemma 101, pp. 70–71",
      "status": "FINITE STABILIZER MUST BE RETAINED",
      "detail": "Quotienting only by the connected stabilizer leaves a finite part; the graph z2=1+z1² has nontrivial finite stabilizer. Degree-one claims require its treatment."
    },
    {
      "locator": "Lemmas 112–117, pp. 74–76",
      "status": "RESTRICTION CONSTRUCTION UNVERIFIED",
      "detail": "B intersect T may include a finite part. Its identity-component torus quotient maps isogenously to pi(B). The torus is not dense in a semiabelian B with positive abelian quotient, contrary to the proof reduction in Lemma 115."
    },
    {
      "locator": "Lemmas 116 and Proposition 118, pp. 75–77",
      "status": "FIELD AND METRIZED IDENTIFICATIONS MUST BE SPECIFIED",
      "detail": "All orbits must use a common defining field for the coset. Torsion translation preserves heights but need not preserve the literal ample line bundle without a suitable power/rational identification and canonical isometry."
    },
    {
      "locator": "Theorems 77, 106 and 129, pp. 48, 72, 81",
      "status": "GENERAL-FAN SIGNATURE AND RESTRICTIONS UNVERIFIED",
      "detail": "Theorem 106 signature omits the earlier general-fan inputs; final Theorem 129 restores them. The restricted models require their own verified inputs. No arbitrary semipositive metric result is inferred."
    },
    {
      "locator": "Propositions 121–126, pp. 78–80",
      "status": "BGPS PRIMARY INPUTS PENDING",
      "detail": "Verify original normal forms, monocriticality, field extension and simultaneous adelic special-point attainment. Separate-place lattice calculation does not replace the original simultaneous construction."
    },
