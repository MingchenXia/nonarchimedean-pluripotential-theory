    "helper_source": "from pathlib import Path\nimport datetime,hashlib,json\nR=Path('/workspace/nonarchimedean-pluripotential-theory');C=R/'source_material/Volume_Covolume_Richardson_integration_20261007';M=R/'manuscript'\nh=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();rd=lambda p:json.loads(Path(p).read_text())\nout=C/'final_book_reading_v2_20261007.json';assert not out.exists()\nbp=C/'baseline_v1_20261007.json';assert h(bp)=='19b80228905b6321be17073ed4115695afa92164bf765bf009c3099999368df8';b=rd(bp)\nsp=C/'source_gate_v1_20261007.json';s=rd(sp);assert s['all_passed']\ngp=C/'release_gates_v2_20261007.json';g=rd(gp);vp=Path(g['view_manifest']);v=rd(vp);np=C/'actual_final_reading_notes_v2_20261007.json';notes=rd(np)\nassert len(notes)==len(v)==g['sheets']==36 and g['selected_page_count']==72\nassert h(g['PDF']['path'])==g['PDF']['sha256'] and h(g['review_PDF'])==g['review_PDF_sha256']\nassert h(g['required_repository_validation']['log_path'])==g['required_repository_validation']['log_sha256']\nassert g['required_repository_validation']['completed_exit_code']==0 and g['source_gate_sha256']==h(sp)\nfor p,x in s['permitted_changes'].items():assert h(R/p)==x['after']\nfor p,x in b['source_closure'].items():\n if 'manuscript/'+p not in s['permitted_changes']:assert h(M/p)==x\nfor p,x in b['protected_input_hashes'].items():assert h(M/p)==x\nfor k in ['prior_frozen_manifests','prior_frozen_exports']:\n for x in b[k]:\n  p=Path(x['path']);p=p if p.is_absolute() else R/p;assert h(p)==x['sha256']\nfor x in [b['native_catalogue_reuse']['source'],b['native_catalogue_reuse']['PDF']]:assert h(R/x['path'])==x['sha256']\nfor i,(a,n) in enumerate(zip(v,notes),1):\n assert n['sheet']==i and n['physical_pages']==a['physical_pages'] and n['reading_mode']=='fresh_complete_selected_text_and_matching_image'\n assert n['complete_selected_text_actually_read'] and n['matching_sheet_image_individually_displayed'] and n['note'].strip()\n assert not a['actually_viewed'] and not a['selected_text_read']\n assert h(a['path'])==a['image_sha256']==n['image_sha256'] and h(a['selected_text_path'])==a['selected_text_sha256']==n['selected_text_sha256']\n assert a['source_PDF_sha256']==g['PDF']['sha256']\nassert [p for a in v for p in a['physical_pages']]==g['final_review_pages']\nfor a in v:a['actually_viewed']=True;a['selected_text_read']=True\nvp.write_text(json.dumps(v,indent=2,ensure_ascii=False)+'\\n')\nx={'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'final_PDF':g['PDF'],'release_gates_sha256':h(gp),'source_gate_sha256':h(sp),'baseline_sha256':h(bp),'notes_path':str(np),'notes_sha256':h(np),'view_manifest_path':str(vp),'view_manifest_sha256':h(vp),'selected_pages':g['final_review_pages'],'selected_page_count':72,'sheets':36,'fresh_complete_text_image_pages':72,'identity_reused_pages':0,'all_selected_text_actually_read':True,'all_matching_images_individually_displayed':True,'scope':'changed sections and appendix openings, seams, three selected TOC pages, and the complete index/bibliography','whole_book_rereading_this_checkpoint':False,'fresh_primary_source_reading':0,'original_result_admitted':False,'independent_model_call_performed':False,'native_catalogue_preserved':True,'helper_source':Path(__file__).read_text()}\nout.write_text(json.dumps(x,indent=2,ensure_ascii=False)+'\\n');print(json.dumps({'record_sha256':h(out),'PDF':g['PDF'],'selected_pages':72,'fresh_pages':72,'sheets':36,'identity_reused_pages':0},indent=2))\n"
