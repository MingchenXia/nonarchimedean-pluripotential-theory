    "helper_source": "from pathlib import Path\nimport datetime,hashlib,json,re\nimport fitz\nfrom PIL import Image,ImageDraw\nR=Path('/workspace/nonarchimedean-pluripotential-theory');M=R/'manuscript';C=R/'source_material/Volume_Covolume_Richardson_integration_20261007';h=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();rd=lambda p:json.loads(Path(p).read_text());out=C/'release_gates_v2_20261007.json';assert not out.exists()\ng=rd(C/'source_gate_v1_20261007.json');assert g['all_passed'];b=rd(C/'baseline_v1_20261007.json')\nfor p,q in g['permitted_changes'].items():assert h(R/p)==q['after']\nvp=C/'required_validation_v2_20261007.log';vl=vp.read_text(errors='replace');assert '\\nOK\\n' in vl and 'Pages:' in vl and 'All targets (book.pdf) are up-to-date' in vl\nlog=(M/'book.log').read_text(errors='replace');patterns={'TeX_errors':r'^!','LaTeX_package_warnings':r'^(?:LaTeX|Package .*?) Warning','pdfTeX_warnings':r'pdfTeX warning','missing_characters':r'Missing character:','overfull_boxes':r'Overfull \\\\','underfull_boxes':r'Underfull \\\\','unresolved_refs_cites':r'(?:Reference|Citation).*undefined','rerun_requests':r'Rerun to get|Label\\(s\\) may have changed|Please \\(re\\)run'};checks={k:len(re.findall(v,log,re.M)) for k,v in patterns.items()};assert all(v==0 for k,v in checks.items() if k!='underfull_boxes'),checks\nblg=(M/'book.blg').read_text();ilg=(M/'book.ilg').read_text();assert re.search(r'warning\\$ -- 0\\b',blg);used=re.search(r\"You've used (\\d+) entries\",blg);assert used and int(used[1])==523\nix=re.search(r'(\\d+) entries accepted, (\\d+) rejected',ilg);il=re.search(r'(\\d+) lines written, (\\d+) warnings',ilg);assert ix and ix[2]=='0' and il and il[2]=='0'\np=M/'book.pdf';d=fitz.open(p);toc=d.get_toc();names=d.resolve_names();assert len(d)>4524 and all(1<=a[2]<=len(d) for a in toc)\nstart=lambda t:next(a[2] for a in toc if a[1]==t)\ntitles=['Geometric realization and differential operators','Total Chern intersections on a projective variety','Projection dimensions and multidegree support','Volume operators and Richardson intersection models'];ends=['Normalization checks','Projection-formula audit','Cohomology retained by tropicalization','Index'];sections={}\nfor t,e in zip(titles,ends):\n assert sum(a[1]==t for a in toc)==1\n lo=start(t);hi=next(a[2] for a in toc if a[2]>lo and (a[0]<=2 if t==titles[-1] else a[1]==e));assert hi>lo;sections[t]={'start':lo,'end':hi}\nbbl=(M/'book.bbl').read_text();labels={key:lab for lab,key in re.findall(r'\\\\bibitem\\[([^\\]]+)\\]\\{([^}]+)\\}',bbl)};newlabels={k:labels[k] for k in g['new_bibliography_keys']};base=lambda s:re.sub('[a-z]$','',s);collisions={k:v for k,v in labels.items() if k not in newlabels and base(v) in {base(x) for x in newlabels.values()}}\npages=set();internal=external=0;invalid=[];collisionpages=[];occ={t:[] for t in titles}\nfor i,page in enumerate(d):\n text=' '.join(page.get_text().split())\n for t in titles:\n  if t in text:occ[t].append(i+1)\n if any(v in text for v in collisions.values()):collisionpages.append(i+1)\n for link in page.get_links():\n  if link['kind']==fitz.LINK_GOTO:\n   internal+=1\n   if not 0<=link.get('page',-1)<len(d):invalid.append([i+1,str(link)])\n  elif link['kind']==fitz.LINK_NAMED:\n   internal+=1;k=link.get('nameddest',link.get('name',''))\n   if k and k not in names and k not in ['NextPage','PrevPage','FirstPage','LastPage']:invalid.append([i+1,k])\n  elif link['kind']==fitz.LINK_URI:external+=1\nassert not invalid and all(0<=v['page']<len(d) for v in names.values() if 'page' in v)\ngroups=re.findall(r'\\\\hyperpage\\{([^}]+)\\}',(M/'book.ind').read_text());assert all(re.fullmatch(r'\\d+(?:(?:, |--|–)\\d+)*',s) for s in groups);ipages={int(n) for s in groups for n in re.findall(r'\\d+',s)};assert all('page.'+str(n) in names for n in ipages)\neqnums={};anchors=[];legacy=0\nfor file,q in g['formal_proof_tag_records'].items():\n aux=(M/Path(file).with_suffix('.aux')).read_text();source=(M/file).read_text()\n for num,label in re.findall(r'\\\\tag\\{([^}]+)\\}\\\\label\\{([^}]+)\\}',source):\n  a=re.search(r'\\\\newlabel\\{'+re.escape(label)+r'\\}\\{\\{\\{([^}]+)\\}\\}\\{[^}]+\\}\\{[^}]*\\}\\{([^}]+)\\}',aux);assert a and a[1]==num,(label,num)\n  if num in q['new_manual_tags']:eqnums[label]=num;anchors.append(a[2])\n  else:assert num in q['old_manual_tags'];legacy+=1\nassert len(anchors)==len(set(anchors))==14 and all(a.startswith('AMS.') and a in names for a in anchors);assert legacy==sum(len(q['old_manual_tags']) for q in g['formal_proof_tag_records'].values())\nfor t,q in sections.items():\n pages.update(range(q['start']-1,q['end']+2));pages.update(n for n in occ[t] if n<q['start'])\nfor t in ['Convex analysis and Legendre duality','Intersection theory and b-divisors','Tropical and idempotent algebra','Theorem provenance and status ledger']:\n lo=start(t);pages.update(range(lo,lo+2))\nindex=start('Index');pages.update(range(index,len(d)+1));pages.update(n for p in collisionpages for n in range(p-1,p+2));pages=sorted(n for n in pages if 1<=n<=len(d))\nO=Path('/tmp/Volume_Covolume_Richardson_final_book_views_v2_20261007');O.mkdir(exist_ok=False);review=fitz.open()\nfor n in pages:review.insert_pdf(d,from_page=n-1,to_page=n-1)\nreview.save(O/'review.pdf');views=[];pdfsha=h(p)\nfor j in range(0,len(pages),2):\n ns=pages[j:j+2];ims=[]\n for n in ns:\n  pix=d[n-1].get_pixmap(matrix=fitz.Matrix(1.18,1.18),alpha=False);ims.append(Image.frombytes('RGB',[pix.width,pix.height],pix.samples))\n im=Image.new('RGB',(sum(a.width for a in ims)+20*(len(ims)-1),max(a.height for a in ims)+28),'white');draw=ImageDraw.Draw(im);x=0\n for n,a in zip(ns,ims):draw.text((x+5,5),f'Final book physical page {n}',fill='black');im.paste(a,(x,28));x+=a.width+20\n pp=O/f'sheet_{j//2+1:02d}.png';im.save(pp);tp=pp.with_suffix('.txt');tp.write_text('\\n\\n'.join(f'FINAL BOOK PHYSICAL PAGE {n}\\n'+d[n-1].get_text() for n in ns));views.append({'path':str(pp),'physical_pages':ns,'image_sha256':h(pp),'selected_text_path':str(tp),'selected_text_sha256':h(tp),'source_PDF_sha256':pdfsha,'actually_viewed':False,'selected_text_read':False})\nmanifest=O/'manifest.json';manifest.write_text(json.dumps(views,indent=2)+'\\n')\nrec={'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'source_gate_sha256':h(C/'source_gate_v1_20261007.json'),'baseline_sha256':h(C/'baseline_v1_20261007.json'),'build_checks':checks,'PDF':{'path':str(p),'pages':len(d),'bytes':p.stat().st_size,'sha256':pdfsha},'required_repository_validation':{'command':'TEXMFHOME=/workspace/.texlive bash scripts/validate-manuscript.sh','completed_exit_code':0,'log_path':str(vp),'log_sha256':h(vp),'refcheck_inventory_unittests_full_build':True},'bibliography':{'cited_entries':523,'new_entries':10,'warnings':0},'index':{'entries_accepted':int(ix[1]),'entries_rejected':0,'lines':int(il[1]),'warnings':0,'page_groups':len(groups),'distinct_numeric_destinations':len(ipages)},'navigation':{'named_destinations':len(names),'internal_links':internal,'external_URL_links':external,'invalid_internal_links':0,'toc_entries':len(toc),'parts':len([a for a in toc if a[0]==1 and a[1].startswith('Part ')])},'new_equation_numbers':eqnums,'new_equation_destinations':anchors,'legacy_equation_numbers_preserved':legacy,'section_physical_pages':sections,'text_occurrences':occ,'citation_labels':{'new_labels':newlabels,'existing_collision_labels':collisions,'collision_pages':collisionpages},'index_start':index,'final_review_pages':pages,'selected_page_count':len(pages),'sheets':len(views),'view_manifest':str(manifest),'review_PDF':str(O/'review.pdf'),'review_PDF_sha256':h(O/'review.pdf'),'reading_flags_initially_false':True,'whole_book_rereading_claimed':False,'helper_source':Path(__file__).read_text()};out.write_text(json.dumps(rec,indent=2)+'\\n');print(json.dumps({k:rec[k] for k in ['build_checks','PDF','bibliography','index','navigation','section_physical_pages','selected_page_count','sheets','final_review_pages']},indent=2))\n"
  },
