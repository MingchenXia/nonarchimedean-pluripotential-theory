    "helper_source": "from pathlib import Path\nimport datetime,hashlib,json,re,subprocess\nR=Path('/workspace/nonarchimedean-pluripotential-theory');M=R/'manuscript';C=R/'source_material/Volume_Covolume_Richardson_integration_20261007';h=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();out=C/'source_gate_v1_20261007.json';assert not out.exists()\nbp=C/'baseline_v1_20261007.json';assert h(bp)=='19b80228905b6321be17073ed4115695afa92164bf765bf009c3099999368df8';b=json.loads(bp.read_text());paths=list(b['formal_blocks']);allowed={'manuscript/'+p for p in paths}|{'manuscript/bibliography/ComplexGeometry.bib'}\nchanges={p:{'before':sha,'after':h(R/p)} for p,sha in b['tracked_file_hashes'].items() if h(R/p)!=sha};assert set(changes)==allowed,changes\nformal=re.compile(r'\\\\begin\\{(theorem|proposition|lemma|corollary|definition|example|remark|warning)\\}.*?\\\\end\\{\\1\\}',re.S);proof=re.compile(r'\\\\begin\\{proof\\}.*?\\\\end\\{proof\\}',re.S);tags=re.compile(r'\\\\tag\\{([^}]+)\\}')\ndef subseq(a,c):\n it=iter(c)\n return all(any(y==x for y in it) for x in a)\nexpected=[3,2,1,0];newtags=[list(map(lambda x:f'D.{x}',range(37,42))),list(map(lambda x:f'F.{x}',range(24,31))),['G.25','G.26'],[]];details={}\nfor i,p in enumerate(paths):\n old=subprocess.check_output(['git','show',b['baseline_commit']+':manuscript/'+p],cwd=R,text=True);cur=(M/p).read_text();assert subseq(old.splitlines(),cur.splitlines()),p\n fb=[hashlib.sha256(x.group(0).encode()).hexdigest() for x in formal.finditer(cur)];pr=[hashlib.sha256(x.group(0).encode()).hexdigest() for x in proof.finditer(cur)];assert subseq(b['formal_blocks'][p],fb) and pr==b['proof_blocks'][p] and len(fb)-len(b['formal_blocks'][p])==expected[i]\n ot=tags.findall(old);ct=tags.findall(cur);assert subseq(ot,ct) and len(ct)==len(set(ct)) and [t for t in ct if t not in ot]==newtags[i]\n details[p]={'old_formal':len(b['formal_blocks'][p]),'new_attributed_formal':expected[i],'old_proofs':len(pr),'old_manual_tags':ot,'new_manual_tags':newtags[i],'all_old_lines_preserved':True,'current_sha256':h(M/p),'new_formal_digests':[x for x in fb if x not in b['formal_blocks'][p]]}\nfor p,sha in b['source_closure'].items():\n if p not in paths:assert h(M/p)==sha,p\nfor p,sha in b['protected_input_hashes'].items():assert h(M/p)==sha,p\noldbib=subprocess.check_output(['git','show',b['baseline_commit']+':manuscript/bibliography/ComplexGeometry.bib'],cwd=R,text=True);newbib=(M/'bibliography/ComplexGeometry.bib').read_text();assert newbib.startswith(oldbib)\noldkeys=re.findall(r'@\\w+\\{([^,]+),',oldbib);keys=re.findall(r'@\\w+\\{([^,]+),',newbib);newkeys=[k for k in keys if k not in oldkeys];assert len(newkeys)==10 and len(keys)==len(set(keys));assert h(M/'bibliography/NonArchimedean.bib')==b['bibliography_baseline']['bibliography/NonArchimedean.bib']\nfor q in b['prior_frozen_manifests']+b['prior_frozen_exports']:\n p=Path(q['path']);p=p if p.is_absolute() else R/p;assert p.stat().st_size==q['bytes'] and h(p)==q['sha256']\nfor k in ['source','PDF']:assert h(R/b['native_catalogue_reuse'][k]['path'])==b['native_catalogue_reuse'][k]['sha256']\nsm=R/b['reused_source_manifest']['path'];assert h(sm)==b['reused_source_manifest']['sha256'];s=json.loads(sm.read_text());assert s['actual_source_page_pairs']==158 and s['actual_matching_sheets']==81 and s['exact_arithmetic_checks']==9\nar=R/'source_material/Volume_Covolume_Richardson_sources_20261007/arithmetic_diagnostics_v3_20261007.json';assert h(ar)==s['arithmetic_diagnostics_sha256'] and json.loads(ar.read_text())['all_checks_passed']\nsubprocess.run(['git','diff','--check'],cwd=R,check=True)\nr={'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'baseline_sha256':h(bp),'all_passed':True,'tracked_files_checked':len(b['tracked_file_hashes']),'permitted_changes':changes,'formal_proof_tag_records':details,'historical_formal_preserved':80,'historical_proofs_preserved':30,'new_attributed_formal':6,'new_proofs':0,'all_old_source_lines_preserved':True,'new_manual_tags':14,'unchanged_active_inputs':421,'protected_inputs':108,'prior_frozen_manifests':117,'prior_frozen_exports':198,'new_bibliography_keys':newkeys,'old_bibliography_prefix_preserved':True,'native_catalogue_preserved':True,'canonical_statuses_preserved':True,'reused_source_pages':158,'fresh_primary_reading':0,'arithmetic_checks_reused':9,'original_result_admitted':False,'independent_model_call_performed':False,'helper_source':Path(__file__).read_text()};out.write_text(json.dumps(r,indent=2)+'\\n');print(json.dumps({k:v for k,v in r.items() if k not in ['helper_source','formal_proof_tag_records','permitted_changes']}))\n"
  },
