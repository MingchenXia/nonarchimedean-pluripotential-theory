  "helper_source": "from pathlib import Path\nimport datetime,hashlib,json,shutil,zipfile,subprocess,re\nimport fitz\nR=Path('/workspace/nonarchimedean-pluripotential-theory');M=R/'manuscript';C=R/'source_material/Volume_Covolume_Richardson_integration_20261007';S=R/'source_material/Volume_Covolume_Richardson_sources_20261007';E=M/'editorial';O=Path('/workspace/book-completion-drafts/research-integration')\nh=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();rd=lambda p:json.loads(Path(p).read_text());now=lambda:datetime.datetime.now(datetime.timezone.utc).isoformat();meta=lambda p:{'path':str(p.relative_to(R)) if p.is_relative_to(R) else str(p),'bytes':p.stat().st_size,'sha256':h(p)}\nrecord=C/'release_package_v2_20261007.json';assert not record.exists()\nbp=C/'baseline_v1_20261007.json';assert h(bp)=='19b80228905b6321be17073ed4115695afa92164bf765bf009c3099999368df8';b=rd(bp)\nsp=C/'source_gate_v1_20261007.json';assert h(sp)=='95acfc5352ff7ae9dace6138ef47a8e6cc3f5ce6dc9a6b66df0a01323a0f5b9f';s=rd(sp);assert s['all_passed']\ngp=C/'release_gates_v2_20261007.json';assert h(gp)=='8e56812c7b820ee5ed6def3e14ca8fb762ef04ee066d2499383af4168bb4ba5f';g=rd(gp)\nrp=C/'final_book_reading_v2_20261007.json';assert h(rp)=='95fd741de70f6072d4a24ef23d5b7dec3a3454bc2a49d6c2e0bf48425d0e8d51';r=rd(rp)\nassert subprocess.check_output(['git','rev-parse','HEAD'],cwd=R,text=True).strip()==b['baseline_commit']\nassert h(g['PDF']['path'])==g['PDF']['sha256']==r['final_PDF']['sha256']\nassert g['PDF']['pages']==4535 and r['fresh_complete_text_image_pages']==72 and r['identity_reused_pages']==0\nassert h(g['view_manifest'])==r['view_manifest_sha256'] and h(r['notes_path'])==r['notes_sha256']\nassert h(g['required_repository_validation']['log_path'])==g['required_repository_validation']['log_sha256'] and g['required_repository_validation']['completed_exit_code']==0\nallowed=set(s['permitted_changes'])|{'README.md','manuscript/editorial/second_reading_and_research_programme_20261002.md'}\nassert {p for p,pin in b['tracked_file_hashes'].items() if h(R/p)!=pin}==allowed\nfor p,x in s['permitted_changes'].items():assert h(R/p)==x['after']\nfor p,pin in b['source_closure'].items():\n if 'manuscript/'+p not in s['permitted_changes']:assert h(M/p)==pin\nfor p,pin in b['protected_input_hashes'].items():assert h(M/p)==pin\nfor k in ['prior_frozen_manifests','prior_frozen_exports']:\n for x in b[k]:\n  p=Path(x['path']);p=p if p.is_absolute() else R/p;assert h(p)==x['sha256']\nfor x in [b['native_catalogue_reuse']['source'],b['native_catalogue_reuse']['PDF']]:assert h(R/x['path'])==x['sha256']\nfor p,pin in b['index_configuration'].items():assert h(R/p)==pin\nclosure={p:h(M/p) for p in b['source_closure']}\nfor p in b['bibliography_baseline']:closure[p]=h(M/p)\nassert len(closure)==427\nkeys=[]\nfor p in b['bibliography_baseline']:\n entries=re.findall(r'^\\s*@([A-Za-z]+)\\s*\\{\\s*([^,\\s{}]+)\\s*,',(M/p).read_text(),re.M)\n keys += [k for t,k in entries if t.lower() not in {'comment','control','preamble','string'}]\nassert len(keys)==len(set(keys))==815\nclosurep=E/'Volume_Covolume_Richardson_integration_source_closure_20261007.sha256';assert not closurep.exists();closurep.write_text(''.join(pin+'  manuscript/'+p+'\\n' for p,pin in sorted(closure.items())))\naudit=E/'Volume_Covolume_Richardson_integration_audit_20261007.md';assert audit.exists()\nsource_review=E/'Volume_Covolume_Richardson_source_review_20261007.md';source_manifest=E/'Volume_Covolume_Richardson_source_review_manifest_20261007.json'\nassert h(source_review)=='43bfe039895e60f961c75469910eb4a544ac67fa126bf20aa5ef7372fd031d2c' and h(source_manifest)=='2a4355673f970cac423e829a2ad231fb96c66827366b5615f21421d61dedbb7d'\nar=S/'arithmetic_diagnostics_v3_20261007.json';assert h(ar)=='58016d92d8391130ab5678935f3c46d3647b1c2c256a2cf9f18262d0b61d604b' and rd(ar)['all_checks_passed']\nmanifestp=E/'Volume_Covolume_Richardson_integration_manifest_20261007.json';assert not manifestp.exists()\nmanifest={'recorded_UTC':now(),'baseline_commit':b['baseline_commit'],'origin_main':b['origin_main'],'source_checkpoint_reuse':{'audit':meta(source_review),'manifest':meta(source_manifest),'source_page_pairs':158,'sheets':81,'complete_PDFs':6,'partial_PDFs':4,'fresh_primary_reading_this_integration':0,'arithmetic_record':meta(ar),'arithmetic_checks':9},'baseline_record_sha256':h(bp),'baseline':b,'source_gate':s,'source_gate_sha256':h(sp),'final_release_gates':g,'final_release_gates_sha256':h(gp),'final_book_reading':r,'final_book_reading_sha256':h(rp),'final_views':rd(Path(g['view_manifest'])),'final_sequential_reading_notes':rd(Path(r['notes_path'])),'active_TeX_input_count':425,'active_TeX_and_bibliography_source_closure':closure,'ordinary_bibliography_keys':815,'BibLaTeX_Control_entries_excluded':1,'source_closure_record':meta(closurep),'editorial_audit':meta(audit),'release_documentation':{p:h(R/p) for p in ['README.md','manuscript/editorial/second_reading_and_research_programme_20261002.md']},'package_preflight_diagnostic':rd(C/'package_preflight_diagnostic_v1_20261007.json'),'superseded_validation_log':meta(C/'required_validation_v1_20261007.log'),'superseded_selector':{'gates':rd(C/'release_gates_v1_20261007.json'),'diagnostic':rd(C/'review_selector_diagnostic_v1_20261007.json'),'actual_reading_credit':0},'latest_metadata_only_survey':rd(C/'latest_metadata_survey_v1_20261007.json'),'no_original_result_or_status_promotion':True,'no_independent_model_call':True,'no_recursive_primary_proof_certificate':True,'full_book_rereading_this_checkpoint':False,'native_editor_changed_or_reopened':False,'helper_source':Path(__file__).read_text()}\nmanifestp.write_text(json.dumps(manifest,indent=2,ensure_ascii=False)+'\\n')\nfull=O/'Non-Archimedean_Pluripotential_Theory_Volume_Covolume_Richardson_2026-10-07.pdf';review=O/'Volume_Covolume_Richardson_Book_Review_2026-10-07.pdf';archive=O/'Non-Archimedean_Pluripotential_Theory_Volume_Covolume_Richardson_Source_2026-10-07.zip'\nassert all(not p.exists() for p in [full,review,archive]);shutil.copyfile(g['PDF']['path'],full);shutil.copyfile(g['review_PDF'],review)\nassert h(full)==g['PDF']['sha256'] and h(review)==g['review_PDF_sha256']\nwith fitz.open(full) as d:assert len(d)==4535\nwith fitz.open(review) as d:assert len(d)==72\nbase=O/'Non-Archimedean_Pluripotential_Theory_Mixed_Segre_Zeta_Source_2026-10-07.zip';assert h(base)=='d07f62072efdd2353f9068448bfca338d888df4f0d50ff62465e7d9a8151322b'\nwith zipfile.ZipFile(base) as z:names=set(z.namelist());assert len(names)==812\nnames|={str(p.relative_to(R)) for p in [source_review,source_manifest,E/'Volume_Covolume_Richardson_source_closure_20261007.sha256',E/'Volume_Covolume_Richardson_source_review_artifacts_20261007.json',E/'Mixed_Segre_zeta_integration_artifacts_20261007.json',audit,manifestp,closurep]}\nassert len(names)==820 and all(not Path(n).is_absolute() and '..' not in Path(n).parts and (R/n).is_file() for n in names)\nassert {'manuscript/'+p for p in closure}.issubset(names)\nartp=E/'Volume_Covolume_Richardson_integration_artifacts_20261007.json';assert not artp.exists() and str(artp.relative_to(R)) not in names\nmembers={}\nwith zipfile.ZipFile(archive,'w',compression=zipfile.ZIP_DEFLATED,compresslevel=9) as z:\n for n in sorted(names):\n  data=(R/n).read_bytes();i=zipfile.ZipInfo(n,date_time=(2026,10,7,0,0,0));i.compress_type=zipfile.ZIP_DEFLATED;i.external_attr=0o100644<<16;z.writestr(i,data);members[n]={'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest()}\nwith zipfile.ZipFile(archive) as z:\n assert set(z.namelist())==names and z.testzip() is None\n for n in names:\n  data=z.read(n);assert data==(R/n).read_bytes() and hashlib.sha256(data).hexdigest()==members[n]['sha256']\nart={'recorded_UTC':now(),'baseline_commit':b['baseline_commit'],'full_book':meta(full)|{'pages':4535},'selected_book_review':meta(review)|{'pages':72,'fresh_complete_text_image_pages':72,'sheets':36,'identity_reused_pages':0,'whole_book_rereading':False},'source_archive':meta(archive)|{'members':len(names),'every_member_checked_against_current_live_bytes':True,'active_TeX_inputs_covered':425,'bibliographies_covered':2,'fresh_isolated_archive_compilation_claimed':False,'artifact_record_excluded_from_own_archive':True},'integration_manifest':meta(manifestp),'source_closure':meta(closurep),'native_catalogue_preserved':True,'prior_frozen_exports_preserved':198,'original_result_admitted':False,'independent_model_call_performed':False}\nartp.write_text(json.dumps(art,indent=2,ensure_ascii=False)+'\\n')\nrecord.write_text(json.dumps({'UTC':now(),'manifest':meta(manifestp),'source_closure':meta(closurep),'artifacts':art,'artifact_record':meta(artp),'archive_member_checks':members,'preservation_rechecked_before_packaging':True,'helper_source':Path(__file__).read_text()},indent=2,ensure_ascii=False)+'\\n')\nprint(json.dumps({'record_sha256':h(record),'manifest':meta(manifestp),'artifact_record':meta(artp),'exports':art},indent=2))\n"
}
