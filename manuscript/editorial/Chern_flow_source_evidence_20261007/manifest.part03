  "private_repository_visibility_changed": false,
  "helper_source": "from pathlib import Path\nimport datetime,hashlib,json,subprocess,zipfile\nimport fitz\n\nR=Path('/workspace/nonarchimedean-pluripotential-theory');M=R/'manuscript';C=R/'source_material/Chern_flow_sources_20261007';N=R/'source_material/Chern_flow_metadata_20261007';E=M/'editorial';O=Path('/workspace/book-completion-drafts/research-integration')\nh=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\npin=lambda p:{'path':str(p),'bytes':Path(p).stat().st_size,'sha256':h(p)}\nrd=lambda p:json.loads(Path(p).read_text())\ngit=lambda *args:subprocess.check_output(['git',*args],cwd=R,text=True).strip()\nout=C/'source_release_package_v1_20261007.json';assert not out.exists()\nb=rd(C/'baseline_v1_20261007.json');assert git('rev-parse','HEAD')==git('rev-parse','origin/work')==b['baseline_commit']\nassert git('rev-parse','origin/main')==b['origin_main'] and not git('diff','--cached','--name-only')\nassert git('diff','--name-only').splitlines()==['README.md']\nfor k in ['source_closure','protected_input_hashes','bibliography_baseline','index_generated']:\n for path,sha in b[k].items():assert h(M/path)==sha,(k,path)\nfor k in ['book_generated','index_configuration']:\n for path,sha in b[k].items():assert h(R/path)==sha,(k,path)\nfor k in ['prior_frozen_manifests','prior_frozen_exports']:\n for q in b[k]:\n  p=Path(q['path']);p=p if p.is_absolute() else R/p;assert h(p)==q['sha256'],p\nfor q in b['native_catalogue_reuse'].values():\n if isinstance(q,dict) and 'path' in q:assert h(R/q['path'])==q['sha256']\nassert len(fitz.open(M/'book.pdf'))==4535\ntracked_deltas=[p for p,sha in b['tracked_file_hashes'].items() if h(R/p)!=sha];assert tracked_deltas==['README.md']\ngate={'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'all_passed':True,'source_only':True,'baseline_commit':b['baseline_commit'],'active_TeX_preserved':425,'bibliographies_preserved':2,'protected_inputs_preserved':108,'prior_frozen_manifests_preserved':119,'prior_exports_preserved':202,'all_generated_book_and_index_bytes_preserved':True,'book_PDF':pin(M/'book.pdf')|{'pages':4535},'native_catalogue_bytes_preserved':True,'native_editor_changed_or_reopened':False,'tracked_file_count':len(b['tracked_file_hashes']),'only_tracked_delta':'README.md: source-review progress link','canonical_statuses_preserved':True,'original_results_promoted':0,'fresh_book_compilation_claimed':False,'fresh_book_review_claimed':False,'whole_book_reread_claimed':False,'baseline_record_SHA256':h(C/'baseline_v1_20261007.json')}\ngp=C/'source_only_preservation_gate_v1_20261007.json';assert not gp.exists();gp.write_text(json.dumps(gate,indent=2)+'\\n')\n\nreceipts=[]\nfor name,sha in [('actual_primary_source_reading_v1_20261007.json','afbc92e9344d8579fc5c726777eaf3c40c49b8ddc52a821b55c5fdb2141d8b75'),('actual_dependency_source_reading_v1_20261007.json','8997fb9ff99537980d1161ea769674cff1f57cec212e5ec24e6d1635694a1df4'),('actual_additional_dependency_source_reading_v1_20261007.json','564466b9bcd2467cda23049da0ea2a54120fdb52debe9e1861311272b12837e6')]:\n p=C/name;assert h(p)==sha;receipts.append(rd(p))\nall_views=[v for q in receipts for v in q['annotated_views']];assert len(all_views)==94\nselection=[];distinct=set()\nfor v in all_views:\n assert v['actually_viewed'] and v['selected_text_read']\n for key,sha in [('path','image_sha256'),('selected_text_path','selected_text_sha256'),('source_PDF_path','source_PDF_sha256')]:assert h(v[key])==v[sha]\n for p in v['physical_pages']:\n  key=(v['source_PDF_sha256'],p);assert key not in distinct;distinct.add(key);selection.append((v['source_PDF_path'],p))\nassert len(selection)==182\nsources={}\nfor path,p in selection:sources.setdefault(path,[]).append(p)\nassert len(sources)==11 and sum(len(ps)==len(fitz.open(path)) for path,ps in sources.items())==3\narith=C/'exact_finite_examples_v2_20261007.json';assert h(arith)=='26f2b5d0cc14e4daf43aa5397110669a1d832389ae46b077d758fd2dbe1961d1';assert rd(arith)['all_checks_passed']\naudit=E/'Chern_flow_source_review_20261007.md';assert audit.exists()\nclosure=E/'Chern_flow_source_closure_20261007.sha256';assert not closure.exists()\nfiles={**b['source_closure'],**b['bibliography_baseline']};assert len(files)==427\nclosure.write_text(''.join(f'{sha}  manuscript/{path}\\n' for path,sha in sorted(files.items())))\npdf=O/'Chern_Flow_Source_Review_2026-10-07.pdf';zp=O/'Chern_Flow_Source_Review_2026-10-07.zip';assert not pdf.exists() and not zp.exists()\nd=fitz.open();opened={}\nfor path,p in selection:\n if path not in opened:opened[path]=fitz.open(path)\n d.insert_pdf(opened[path],from_page=p-1,to_page=p-1)\nassert len(d)==182\nd.set_metadata({'title':'Chern Flow: Actually Read Source Pages','subject':'182 source pages, 3 complete PDFs and 8 partial readings; source-only checkpoint','author':'Source authors identified in the companion audit','creator':'Selection in actual recorded reading order'})\nd.save(pdf,garbage=4,deflate=True);d.close()\nfor p in opened.values():p.close()\n\nfull=C/'source_review_full_manifest_v1_20261007.json';assert not full.exists()\nmanifest=E/'Chern_flow_source_review_manifest_20261007.json';art=E/'Chern_flow_source_review_artifacts_20261007.json';partsroot=E/'Chern_flow_source_evidence_20261007';assert not manifest.exists() and not art.exists();partsroot.mkdir(exist_ok=False)\nsource_records=[pin(p) for root in [C,N] for p in sorted(root.rglob('*')) if p.is_file()]\nsource_models=[{'path':path,'sha256':h(path),'physical_pages':len(fitz.open(path)),'selected_physical_pages':ps,'whole_PDF_actually_read':len(ps)==len(fitz.open(path))} for path,ps in sources.items()]\nrecord={'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'checkpoint_type':'source-only actual reading and finite diagnostics','baseline_commit':b['baseline_commit'],'observed_origin_main':b['origin_main'],'baseline_record':pin(C/'baseline_v1_20261007.json'),'audit':pin(audit),'source_closure':pin(closure),'source_closure_members':427,'source_models':source_models,'actual_source_page_pairs':182,'actual_matching_images':94,'whole_PDFs':3,'partial_PDFs':8,'actual_reading_receipts':receipts,'source_records':source_records,'exact_finite_diagnostics':pin(arith),'finite_diagnostic_groups':9,'finite_balance_profiles':2141,'failed_v1_preserved':pin(C/'exact_finite_examples_failed_v1_20261007.json'),'source_only_preservation_gate':gate,'source_only_preservation_gate_SHA256':h(gp),'primary_source_PDF_SHA256':'104cf0d48495ae1427ec3653ada990cc12738aedb23e27c7ca69f8bd93abecc5','independent_model_receipt_obtained':False,'recursive_foundational_proof_audit_claimed':False,'original_results_promoted':0,'canonical_status_promoted':False,'general_BJ22_Siu_or_envelope_repair_claimed':False,'future_live_integration_certified':False,'source_review_PDF':pin(pdf)|{'pages':182},'user_evidence_upload_authorization':pin(C/'github_prepublication_heads_v1_20261007.json'),'private_repository_visibility_changed':False,'helper_source':Path(__file__).read_text()}\nfull.write_text(json.dumps(record,indent=2,ensure_ascii=False)+'\\n')\nchunks=[];buf=b'';limit=96*1024\nfor line in full.read_bytes().splitlines(keepends=True):\n assert len(line)<=limit\n if len(buf)+len(line)>limit:chunks.append(buf);buf=b''\n buf+=line\nif buf:chunks.append(buf)\nparts=[]\nfor i,raw in enumerate(chunks,1):\n p=partsroot/f'manifest.part{i:02d}';raw.decode('utf-8');p.write_bytes(raw);parts.append(pin(p)|{'order':i,'git_blob_sha':hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\\0'+raw).hexdigest()})\nassert b''.join(Path(p['path']).read_bytes() for p in parts)==full.read_bytes()\ncompact={'UTC':record['UTC'],'checkpoint_type':record['checkpoint_type'],'baseline_commit':b['baseline_commit'],'observed_origin_main':b['origin_main'],'audit':pin(audit),'source_closure':pin(closure),'baseline_record':pin(C/'baseline_v1_20261007.json'),'full_evidence_manifest':pin(full),'evidence_parts':parts,'reconstruction':'Concatenate the listed part bytes in numeric order, with no inserted separator; verify the full manifest SHA256','actual_source_page_pairs':182,'actual_matching_images':94,'whole_PDFs':3,'partial_PDFs':8,'finite_diagnostic_groups':9,'finite_balance_profiles':2141,'preservation':gate,'reading_receipt_pins':[pin(C/f) for f in ['actual_primary_source_reading_v1_20261007.json','actual_dependency_source_reading_v1_20261007.json','actual_additional_dependency_source_reading_v1_20261007.json']],'exact_finite_diagnostics':pin(arith),'failed_diagnostic_preserved':True,'source_review_PDF':pin(pdf)|{'pages':182},'original_results_promoted':0,'independent_model_receipt_obtained':False,'private_repository_visibility_changed':False,'user_evidence_upload_authorization':pin(C/'github_prepublication_heads_v1_20261007.json')}\nmanifest.write_text(json.dumps(compact,indent=2,ensure_ascii=False)+'\\n')\n\nentries={}\nfor root,label in [(C,'source_records'),(N,'primary_source')]:\n for p in sorted(root.rglob('*')):\n  if p.is_file():entries[f'{label}/'+str(p.relative_to(root))]=p\nfor j,q in enumerate(receipts,1):\n root=Path(q['annotated_views'][0]['path']).parent\n for p in sorted(root.iterdir()):\n  if p.is_file():entries[f'views/stage{j}/'+p.name]=p\nfor name in sorted(files):entries['manuscript/'+name]=M/name\nfor p in [audit,closure,manifest,*[Path(q['path']) for q in parts]]:entries['editorial/'+str(p.relative_to(E))]=p\nfor p in sorted(Path('/tmp').glob('Chern_flow_*20261007.py')):entries['frozen_helpers/'+p.name]=p\nentries['review/'+pdf.name]=pdf\nwith zipfile.ZipFile(zp,'w',compression=zipfile.ZIP_DEFLATED,compresslevel=6) as zf:\n for name,p in sorted(entries.items()):zf.write(p,name)\nwith zipfile.ZipFile(zp) as zf:\n assert zf.testzip() is None and len(zf.namelist())==len(entries)\n for name,p in entries.items():assert zf.read(name)==p.read_bytes(),name\nartifacts=[pin(pdf)|{'type':'selected_source_review_PDF','pages':182,'book_compilation':False},pin(zp)|{'type':'source_review_evidence_and_unchanged_TeX_closure','members':len(entries),'all_member_bytes_verified':True,'isolated_archive_compilation_claimed':False}]\nart.write_text(json.dumps({'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'source_audit':pin(audit),'source_manifest':pin(manifest),'source_closure':pin(closure),'artifacts':artifacts,'full_manifest':pin(full),'evidence_parts':parts,'self_included_in_bundle':False,'actual_source_pages':182,'matching_images':94,'whole_PDFs':3,'partial_PDFs':8,'baseline_book_PDF':b['baseline_PDF'],'book_or_native_catalogue_changed':False,'original_result_or_independent_receipt_promoted':False},indent=2,ensure_ascii=False)+'\\n')\nrepo_files=[audit,manifest,closure,art,*[Path(q['path']) for q in parts],R/'README.md']\nreceipt={'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'repo_files':[pin(p)|{'repo_path':str(p.relative_to(R)),'git_blob_sha':git('hash-object',str(p))} for p in repo_files],'artifacts':artifacts,'member_inventory':[{'archive_path':name,**pin(p)} for name,p in sorted(entries.items())],'all_member_bytes_verified':True,'full_manifest_SHA256':h(full),'evidence_part_count':len(parts),'book_changed':False,'helper_source':Path(__file__).read_text()}\nout.write_text(json.dumps(receipt,indent=2,ensure_ascii=False)+'\\n');print(json.dumps({'receipt_SHA256':h(out),'repo_file_count':len(repo_files),'evidence_part_count':len(parts),'full_manifest_SHA256':h(full),'audit_SHA256':h(audit),'compact_manifest_SHA256':h(manifest),'closure_SHA256':h(closure),'artifacts':artifacts,'preservation_gate_SHA256':h(gp)},indent=2))\n"
}
