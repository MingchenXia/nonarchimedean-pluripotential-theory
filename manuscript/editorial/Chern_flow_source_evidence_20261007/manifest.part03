      "helper_source": "from pathlib import Path\nimport datetime,hashlib,json\nC=Path('/workspace/nonarchimedean-pluripotential-theory/source_material/Chern_flow_sources_20261007')\nh=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nout=C/'actual_dependency_source_reading_v1_20261007.json';assert not out.exists()\nprep=C/'dependency_view_preparation_v1_20261007.json'\nassert h(prep)=='70a490d79611449488012dbb0e4460b463f3f83bd09405a6e542983fee1a756f'\ng=json.loads(prep.read_text());vp=Path(g['manifest_path']);assert h(vp)==g['initial_manifest_SHA256']\nvs=json.loads(vp.read_text());np=C/'actual_dependency_reading_notes_v1_20261007.json';ns=json.loads(np.read_text());assert len(vs)==len(ns)==47\npairs=[]\nfor i,(v,n) in enumerate(zip(vs,ns),1):\n assert n['sheet']==i and n['source_id']==v['source_id'] and n['physical_pages']==v['physical_pages']\n assert n['complete_selected_text_actually_read'] and n['matching_sheet_image_individually_displayed']\n assert not v['actually_viewed'] and not v['selected_text_read']\n for k,s in [('path','image_sha256'),('selected_text_path','selected_text_sha256'),('source_PDF_path','source_PDF_sha256')]:assert h(v[k])==v[s]\n assert n['source_PDF_SHA256']==v['source_PDF_sha256'] and n['image_SHA256']==v['image_sha256'] and n['complete_text_SHA256']==v['selected_text_sha256']\n v.update(actually_viewed=True,selected_text_read=True,reading_note_sheet=i);pairs.extend((v['source_id'],p) for p in v['physical_pages'])\nassert len(pairs)==len(set(pairs))==90\nassert set(pairs)=={(s,p) for s,ps in g['selection'].items() for p in ps}\nvp.write_text(json.dumps(vs,indent=2,ensure_ascii=False)+'\\n')\nq={'UTC':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'Exactly the declared selected physical pages, complete LP paper; incomplete proofs and cited foundations explicitly bounded in sequential notes','source_page_pairs_actually_read':90,'matching_images_individually_displayed':47,'selection':g['selection'],'complete_primary_PDFs_read':['Larson_Partida'],'reused_page_pairs':0,'view_preparation_SHA256':h(prep),'actual_notes_SHA256':h(np),'annotated_view_manifest_SHA256':h(vp),'sequential_notes':ns,'annotated_views':vs,'external_dependencies_recursively_certified':False,'original_result_promoted':False,'second_model_verifier_receipt_obtained':False,'book_changes_performed':False,'helper_source':Path(__file__).read_text()}\nout.write_text(json.dumps(q,indent=2,ensure_ascii=False)+'\\n');print(json.dumps({'record':str(out),'SHA256':h(out),'pages':90,'images':47,'notes_SHA256':h(np),'views_SHA256':h(vp)}))\n"
