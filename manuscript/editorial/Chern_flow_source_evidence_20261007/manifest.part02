d_views':vs,'bibliographic_shorthand_correction':{'incorrect_shorthand':'AHK','correct_source':'Amini–Huh–Larson, arXiv:2511.02026v1, §4.3 Lemma 4.6','correction_note':37,'incorrect_notes_preserved_for_provenance':True,'book_was_not_edited_from_incorrect_shorthand':True},'external_dependencies_recursively_certified':False,'original_result_promoted':False,'second_model_verifier_receipt_obtained':False,'book_changes_performed':False,'helper_source':Path(__file__).read_text()};out.write_text(json.dumps(q,indent=2,ensure_ascii=False)+'\\n');print(json.dumps({'record':str(out),'SHA256':h(out),'pages':74,'images':37,'notes_SHA256':h(np),'views_SHA256':h(vp)}))\n"
