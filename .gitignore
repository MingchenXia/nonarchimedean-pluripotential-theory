# Operating-system metadata
.DS_Store
__MACOSX/

# Downloaded references and local scratch material
/source_material/
/tmp/
/build_wu_audit/
/.texlive/

# LaTeX build trees and one-off audit drivers
/manuscript/build*/
/manuscript/tmp/
/manuscript/manuscript/
/manuscript/*.tex
!/manuscript/book.tex
/manuscript/*.pdf
/manuscript/*.stdout

# LaTeX-generated files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
/manuscript/*.index-normalization.json
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.thm
*.toc
*.xdv

# Retain only the audited current release artifacts
/output/pdf/*
!/output/pdf/Non-Archimedean_Pluripotential_Theory.pdf
/output/source/*
!/output/source/Non-Archimedean_Pluripotential_Theory_Source_2026-08-24.zip
